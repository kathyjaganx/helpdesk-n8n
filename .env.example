# =====================================================================
# PLANTILLA de variables de entorno.
# 1. Copiar este archivo como .env
# 2. Cambiar TODOS los valores "CAMBIAR_..."
# El archivo .env NUNCA se sube a Git (está en .gitignore).
# =====================================================================

# --- Administrador de PostgreSQL (también BD interna de n8n) ---
# Los nombres de usuario NO pueden empezar con "pg_" (reservado por PostgreSQL)
POSTGRES_USER=helpdesk_admin
POSTGRES_PASSWORD=CAMBIAR_password_admin
POSTGRES_DB=n8n

# --- Usuario de la aplicación Help Desk (privilegios mínimos) ---
HELPDESK_DB=helpdesk
HELPDESK_USER=helpdesk_app
HELPDESK_PASSWORD=CAMBIAR_password_app

# --- Llave de cifrado de credenciales de n8n (64 caracteres hex) ---
# Linux/Mac/Git Bash:  openssl rand -hex 32
# PowerShell:          -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
N8N_ENCRYPTION_KEY=CAMBIAR_llave_de_64_caracteres

# --- Token de acceso a los webhooks (64 caracteres hex) ---
# Se genera con el mismo comando de la llave de cifrado.
# Debe ser IGUAL al valor de la credencial "Header Auth Help Desk" en n8n.
# nginx lo agrega a las peticiones de la página web: nunca llega al navegador.
HELPDESK_API_TOKEN=CAMBIAR_token_de_64_caracteres

# --- Zona horaria ---
GENERIC_TIMEZONE=America/Guatemala
